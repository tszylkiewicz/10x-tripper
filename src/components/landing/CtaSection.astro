---

---

<section class="relative overflow-hidden bg-primary px-4 py-8 sm:py-20">
  <!-- Decorative elements -->
  <div class="absolute inset-y-0 left-0 w-1/3">
    <svg
      class="h-full w-full"
      viewBox="0 0 400 300"
      preserveAspectRatio="none"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M20 200 L100 100 L200 160 L300 60 L380 120" stroke="#5EEAD4" stroke-width="2" opacity="0.3"></path>
      <path d="M20 240 C 80 210, 140 260, 200 240 S 320 210, 380 250" stroke="#5EEAD4" stroke-width="1.5" opacity="0.25"
      ></path>
      <path d="M20 280 C 100 260, 160 295, 240 270 S 340 255, 380 285" stroke="#5EEAD4" stroke-width="1.5" opacity="0.2"
      ></path>
    </svg>
  </div>
  <div class="absolute inset-y-0 right-0 w-1/3">
    <svg
      class="h-full w-full"
      viewBox="0 0 400 300"
      preserveAspectRatio="none"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <circle cx="80" cy="60" r="5" fill="#F59E0B" opacity="0.2"></circle>
      <circle cx="280" cy="130" r="5" fill="#F59E0B" opacity="0.2"></circle>
      <circle cx="150" cy="210" r="5" fill="#F59E0B" opacity="0.2"></circle>
      <circle cx="340" cy="260" r="5" fill="#F59E0B" opacity="0.2"></circle>
      <path d="M85 60 C 140 80, 220 100, 275 130" stroke="#F59E0B" stroke-width="1.5" stroke-dasharray="6 6"
            opacity="0.2"
      ></path>
      <path
        d="M280 135 C 240 160, 180 185, 155 210"
        stroke="#F59E0B"
        stroke-width="1.5"
        stroke-dasharray="6 6"
        opacity="0.2"></path>
      <path
        d="M155 215 C 210 230, 280 245, 335 260"
        stroke="#F59E0B"
        stroke-width="1.5"
        stroke-dasharray="6 6"
        opacity="0.2"></path>
    </svg>
  </div>

  <!-- Content -->
  <div class="relative mx-auto max-w-2xl text-center">
    <h2 class="text-2xl font-bold text-white sm:text-[30px]">Twoja następna podróż czeka na plan</h2>
    <p class="mx-auto mt-4 max-w-lg text-base text-white/80">
      Dołącz do Tripper i zamień swoje pomysły w konkretny plan wycieczki. Wystarczy kilka minut.
    </p>
    <div class="mt-8">
      <a
        href="/register"
        class="inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-base font-semibold text-primary shadow-lg hover:bg-gray-50 transition-colors"
      >
        Stwórz swój pierwszy plan — za darmo
      </a>
    </div>
    <p class="mt-4 text-xs text-white/60">Nie wymagamy karty kredytowej. Załóż konto i zacznij planować.</p>
  </div>
</section>
