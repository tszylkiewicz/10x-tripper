---
interface Props {
  label: string;
  width?: string;
  height?: string;
  class?: string;
}

const { label, width = "100%", height = "300px", class: className = "" } = Astro.props;
---

<div
  class:list={[
    "flex items-center justify-center rounded-xl border border-dashed border-[#5EEAD4] bg-[#5EEAD4]/10",
    className,
  ]}
  style={`width: ${width}; height: ${height};`}
>
  <span class="text-sm text-[#64748B] text-center px-4">{label}</span>
</div>
