<section class="px-4 py-8 sm:py-20">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-12 lg:flex-row lg:gap-16">
    <!-- Text content -->
    <div class="flex flex-1 flex-col items-center text-center lg:items-start lg:text-left">
      <h1 class="text-3xl font-bold leading-tight text-foreground sm:text-4xl lg:text-[36px]">
        Każda wielka podróż zaczyna się od planu
      </h1>
      <p class="mt-6 max-w-lg text-lg text-muted-foreground">
        Masz pomysł na wyjazd, ale brakuje Ci czasu na planowanie? Wpisz swoje notatki — sztuczna inteligencja zamieni
        je w szczegółowy, wielodniowy plan wycieczki dopasowany do Twoich preferencji.
      </p>
      <div class="mt-8 flex flex-col items-center gap-3 lg:items-start">
        <a
          href="/register"
          class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3 text-base font-semibold text-primary-foreground shadow-sm hover:bg-primary-dark transition-colors"
        >
          Zaplanuj swoją pierwszą wycieczkę
        </a>
        <a href="#jak-to-dziala" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
          Dowiedz się więcej ↓
        </a>
      </div>
    </div>

    <!-- Illustration -->
    <div class="flex-1 lg:block">
      <img
        src="/hero-traveler.png"
        alt="Podróżnik z plecakiem patrzący na mapę z pinezkami tras"
        width="500"
        height="400"
        class="h-auto w-full max-w-[500px]"
      />
    </div>
  </div>
</section>
