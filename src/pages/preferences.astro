---
/**
 * Preferences Page
 *
 * Strona zarządzania preferencjami użytkownika.
 * Wyświetla listę preferencji i pozwala na operacje CRUD.
 *
 * Route: /preferences
 */

import Layout from "../layouts/Layout.astro";
import { PreferencesView } from "@preferences/components/PreferencesView.tsx";
import { shouldRenderPage } from "@feature-flags";

// Get env from runtime context (Cloudflare) or fallback to import.meta.env (local dev/E2E)
// The feature flag system handles the fallback internally, so we just pass runtime.env if available
const env = Astro.locals.runtime?.env;

// Check feature flag - redirect to home if preferences feature is disabled
// shouldRenderPage will fall back to import.meta.env internally if env is undefined
if (!shouldRenderPage("preferences", env)) {
  return Astro.redirect("/");
}
---

<Layout title="Moje Preferencje - Tripper">
  <main>
    <PreferencesView client:load />
  </main>
</Layout>
