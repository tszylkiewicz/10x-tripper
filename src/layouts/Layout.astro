---
import "../styles/global.css";
import AppNavigation from "../components/navigation/AppNavigation.astro";
import AuthNavbar from "../components/navigation/AuthNavbar.astro";

interface Props {
  title?: string;
  description?: string;
  showNavigation?: boolean;
  showAuthNavbar?: boolean;
}

const { title = "Tripper", description, showNavigation = true, showAuthNavbar = false } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts - Nunito & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body>
    {showNavigation && <AppNavigation currentPath={Astro.url.pathname} />}
    {showAuthNavbar && <AuthNavbar />}
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
